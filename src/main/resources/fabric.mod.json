{
	"schemaVersion": 1,
	"id": "directorscutworkstation",
	"version": "${version}",
	"name": "Directors Cut Workstation",
	"description": "This mod will turn your Minecraft into a live streaming workstation.",
	"authors": [
		"litkoit"
	],
	"contact": {
		"sources": "https://github.com/litkoit1003/directors-cut-workstation",
		"issues" : "https://github.com/litkoit1003/directors-cut-workstation/issues"
	},
	"license": "MIT",
	"icon": "assets/directorscutworkstation/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"org.litkoit.DirectorsCutWorkstation"
		],
		"client": [
			"org.litkoit.client.DirectorsCutWorkstationClient"
		]
	},
	"mixins": [
		"directorscutworkstation.mixins.json",
		{
			"config": "directorscutworkstation.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}